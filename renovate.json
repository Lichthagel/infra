{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "minimumReleaseAge": "24 hours",
  "labels": [
    "dependencies"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Group LiteLLM Helm chart and image updates",
      "matchFileNames": [
        "apps/litellm/**"
      ],
      "matchManagers": [
        "helmv3",
        "helm-values"
      ],
      "groupName": "LiteLLM"
    }
  ]
}
